# Backend
backend/venv/
.venv/
backend/__pycache__/
backend/app/__pycache__/
backend/app/api/__pycache__/
backend/app/core/__pycache__/
backend/app/services/__pycache__/
*.pyc
*.env
.env
.env.*


# Frontend
frontend/node_modules/
frontend/.next/
fr_claude/node_modules/
fr_claude/.next/

# Copies jetables de l'app Next.js créées pour l'exploration du logo
# (frontend-rosette, frontend-ribbon-s…) — le résultat retenu est intégré
# dans frontend/, ces variantes n'ont pas vocation à vivre dans l'historique.
/frontend-*/

# Variantes produit conservées : contrairement aux explorations de logo, elles
# doivent pouvoir être versionnées. Leurs .gitignore locaux excluent toujours
# node_modules, .next et les autres artefacts de build.
!/frontend-redesign/
!/frontend-redesign/**
!/frontend-harmonized/
!/frontend-harmonized/**

# Sortie du code généré : le pipeline de modélisation écrit `metrics.json` dans
# son répertoire de travail, qui est backend/ quand l'exécution retombe en local
# faute de Docker. C'est un résultat de run, pas une source.
backend/metrics.json

# IDEs and OS
.vscode/
.idea/
.DS_Store

# Large ML Models (too large for GitHub - >100MB)
backend/BLEURT-20-D12/
backend/BLEURT-20-D12.zip
backend/*.zip

# Rapports générés par backend/eval_server.py (harnais d'évaluation manuel) —
# artefacts de sortie, pas du code source.
backend/eval_report_*.pdf
backend/eval_insighteval_*.json
backend/eval_insighteval_report_*.pdf


# Runtime Data (generated at runtime, not source code)
data/chroma/
data/sessions.db
data/uploads/
data/visual_docs/
data/models/
data/insighteval/
cache.db
backend/cache.db

# Jeu de données InfiAgent-DABench (~60 Mo) — re-téléchargeable à l'identique
# avec backend/download_dabench.py, donc hors du dépôt.
backend/data/

# Venv dédié à TimeCopilot (~5 Go) — dépendances incompatibles avec le venv
# principal, voir backend/requirements-timecopilot.txt
backend/.venv-timecopilot/

# Claude Code : état local (verrou de tâche planifiée, permissions locales) —
# spécifique à la machine, jamais partagé.
.claude/

# DONNÉES PERSONNELLES — ne doivent JAMAIS entrer dans ce dépôt, qui est public.
# Sorties des essais d'OCR sur des documents réels (listes de réclamations) :
# elles contiennent des noms, dates de naissance, sexes, notes et décisions
# administratives concernant des personnes nommées. Les publier serait une
# divulgation de données personnelles, irréversible une fois poussée.
backend/ocr_result*.md
backend/dataset_*.csv
backend/dataset_*.json
